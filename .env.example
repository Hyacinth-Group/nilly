# Normal users: run `discord-bot init`. This file is an advanced configuration reference.
DISCORD_TOKEN=your_discord_token_here

# optional. your Discord user id: always liked, only one who can use /model <id>
OWNER_ID=

# optional qualified owner (takes precedence over OWNER_ID), e.g. telegram:user:42
# Invalid nonblank OWNER_KEY does not fall back to numeric OWNER_ID.
OWNER_KEY=

# optional. hours from UTC for the sleep schedule, e.g. 0, -5, 5.5; default 0
TZ_OFFSET=

# ai: one of these two is enough; if both are set, openrouter wins, use PROVIDER=mistral to force mistral
OPENROUTER_KEY=
MISTRAL_KEY=
PROVIDER=
MODEL=
# optional: overrides the openai-compatible chat/completions url (if you have your own router)
API_URL=

# optional
FIRECRAWL_KEY=
NEWS_CHANNEL=

# optional RSS feed for the news/agenda agents; default BBC World for en, Sozcu for tr
NEWS_RSS=

# optional, if both are empty the bot runs in every server/channel it can reach.
# GUILD_ID is a single server id; CHANNELS is a comma-separated list of channel ids.
GUILD_ID=
CHANNELS=

# optional: when /debug is on, decision traces go to this channel; otherwise to the message's own channel
DEBUG_CHANNEL=

# optional, defaults to on. off/0/no -> attached images aren't read.
# read only at startup, can't be changed at runtime by any command (deliberate).
IMAGE_ANALYSIS=

# optional, defaults to off. on/1/yes -> reduced bot UI, not passing as a human.
# slash commands aren't registered or touched at all, interactions are ignored, no embeds are sent
# (version announcement, debug traces, prank notices), thinking is never shown, and streamed
# replies are posted once finished instead of being live-edited. read only at startup.
STEALTH=

# optional, defaults to en; tr is also available. the bot's language: picks which prompts/<lang>/ and
# langs/<lang>.json get read, fixed for the process (BOT_LANG, not LANG: LANG is usually
# already set by the shell for the OS locale, kept separate on purpose). tr and en are filled in.
BOT_LANG=

# optional. log level: error/warn/info/debug/trace (default info).
LOG_LEVEL=
# optional. on/off (default: on in a terminal, off when logging to a file).
LOG_COLOR=
