# Normal users: run `nibby init`. This file is an advanced configuration reference.
# Configure Discord, Telegram, a complete Slack token pair, Matrix, or any combination.
# Leave DISCORD_TOKEN blank for Telegram-only, Slack-only or Matrix-only operation.
DISCORD_TOKEN=

# Telegram: create a bot with @BotFather /newbot. Keep its token secret.
# For ordinary group messages: /setprivacy -> Disable, then remove/re-add the bot
# to existing groups, or make it a group administrator. Allow sending messages.
TELEGRAM_TOKEN=
# Default deny: blank approves NO Telegram rooms. Comma-separated native negative
# group IDs or canonical RoomKeys; e.g. -100123,telegram:room:-456.
TELEGRAM_ROOMS=

# Slack Socket Mode: both tokens required together. Never share either token.
# xapp- token: Basic Information -> App-Level Tokens, scope connections:write.
# xoxb- token: install docs/slack-app-manifest.yml, OAuth & Permissions.
SLACK_APP_TOKEN=
SLACK_BOT_TOKEN=
# Explicit opt-in learning allowlist: native channel IDs, e.g. C01234567,G01234567.
# Missing/blank denies all Slack channels. Invite bot to every approved channel.
# Only trusted, approved channels may contribute to the shared brain.
SLACK_CHANNELS=
# History rate classification: default internal uses >=1s spacing, <=100 messages/page.
# Commercial non-Marketplace apps: restricted uses >=60s spacing, <=15 messages/page.
# HTTP 429 Retry-After is honored in either tier; no automatic request retry.
SLACK_HISTORY_TIER=
# Optional ignored live-test channel; leave blank outside deliberate live testing.
SLACK_TEST_CHANNEL=

# Matrix: requires a build with the `matrix` Cargo feature; plaintext rooms only.
# Use a dedicated account; keep DISCORD_TOKEN blank for a Matrix-only deployment.
# Sync uses outbound HTTP(S), including behind NAT; no inbound port is required.
MATRIX_HOMESERVER=
MATRIX_USER=
# preferred: access token copied privately from the bot account's client/dev tools
MATRIX_ACCESS_TOKEN=
# alternative login: password for MATRIX_USER (only needed without a saved session/token)
MATRIX_PASSWORD=
# optional explicit allowlist: native !room IDs, including opaque IDs and !id:server,
# comma-separated (not #aliases).
# Blank does NOT approve all joined rooms: only owner-approved invitations are accepted.
# Approved rooms share the bot's brain; tell members about local storage/model processing.
MATRIX_ROOMS=

# optional. your Discord user id: always liked, only one who can use /model <id>
OWNER_ID=

# optional qualified owner (takes precedence over OWNER_ID), e.g. slack:user:T01234567:U01234567
# or telegram:user:42. Matrix requires the owner's canonical percent-encoded ID, e.g.
# OWNER_KEY=matrix:user:%40owner%3Amatrix.org for @owner:matrix.org.
# Matrix invites/administration are owner-only; unset owner cannot approve new rooms.
# Invalid nonblank OWNER_KEY does not fall back to numeric OWNER_ID.
OWNER_KEY=

# optional. hours from UTC for the sleep schedule, e.g. 0, -5, 5.5; default 0
TZ_OFFSET=

# ai: one of these two is enough; if both are set, openrouter wins, use PROVIDER=mistral to force mistral
OPENROUTER_KEY=
MISTRAL_KEY=
PROVIDER=
MODEL=
# optional: overrides the openai-compatible chat/completions url (if you have your own router)
API_URL=

# optional
FIRECRAWL_KEY=
NEWS_CHANNEL=

# optional RSS feed for the news/agenda agents; default BBC World for en, Sozcu for tr
NEWS_RSS=

# Discord only: optional, if both are empty Discord runs in every server/channel it can reach.
# GUILD_ID is a single Discord server id; CHANNELS is comma-separated Discord channel ids.
GUILD_ID=
CHANNELS=

# optional: when /debug is on, decision traces go to this channel; otherwise to the message's own channel
DEBUG_CHANNEL=

# optional, defaults to on. off/0/no -> attached images aren't read, including Slack private files.
# read only at startup, can't be changed at runtime by any command (deliberate).
IMAGE_ANALYSIS=

# optional, defaults to off. on/1/yes -> reduced bot UI, not passing as a human.
# slash commands aren't registered or touched at all, interactions are ignored, no embeds are sent
# (version announcement, debug traces, prank notices), thinking is never shown, and streamed
# replies are posted once finished instead of being live-edited. read only at startup.
STEALTH=

# optional, defaults to en; tr is also available. the bot's language: picks which prompts/<lang>/ and
# langs/<lang>.json get read, fixed for the process (BOT_LANG, not LANG: LANG is usually
# already set by the shell for the OS locale, kept separate on purpose). tr and en are filled in.
BOT_LANG=

# optional. log level: error/warn/info/debug/trace (default info).
LOG_LEVEL=
# optional. on/off (default: on in a terminal, off when logging to a file).
LOG_COLOR=

# Local authenticated browser setup and administration; no admin password in this file.
PANEL_ENABLED=on
PANEL_BIND=127.0.0.1
PANEL_PORT=8787
PANEL_CONFIG_PATH=.env
# Optional explicit HTTPS origin; forwarded headers are not trusted.
PANEL_PUBLIC_URL=
PANEL_TRUSTED_PROXIES=
